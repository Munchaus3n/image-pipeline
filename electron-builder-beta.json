{
  "appId": "com.cutoutstudio.app.beta",
  "productName": "Cutout Studio Beta",
  "asar": true,
  "directories": {
    "output": "beta/v${version}"
  },
  "files": [
    "electron/**",
    "editor-ui/dist/**"
  ],
  "extraResources": [
    {
      "from": "backend-dist/image-pipeline-api",
      "to": "backend/image-pipeline-api"
    },
    {
      "from": "realesrgan-ncnn-vulkan",
      "to": "realesrgan-ncnn-vulkan",
      "filter": [
        "**/*",
        "!models/realesr-animevideov3-x3.*",
        "!models/realesr-animevideov3-x4.*",
        "!models/realesrgan-x4plus-anime.*",
        "!vcomp140d.dll"
      ]
    },
    {
      "from": "templates",
      "to": "templates"
    },
    {
      "from": "build-seed/templates_custom.json",
      "to": "templates_custom.json"
    }
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "compression": "maximum",
  "electronLanguages": [
    "en-US"
  ]
}
