{
  "name": "image-pipeline-electron-shell",
  "version": "0.3.1",
  "private": true,
  "description": "Electron packaging shell for Cutout Studio.",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:electron:dev:ui\" \"npm:electron:dev:app\"",
    "electron:dev:ui": "npm --prefix editor-ui run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "electron:dev:app": "set ELECTRON_RUN_AS_NODE=&& wait-on tcp:127.0.0.1:5173 && electron .",
    "electron:build-ui": "npm --prefix editor-ui run build",
    "backend:build": "node scripts/build-backend.cjs",
    "test:electron": "node --test scripts/electron-security.test.cjs",
    "electron:dist": "npm run electron:dist:win",
    "electron:dist:win": "npm run electron:build-ui && npm run backend:build && npm run prepare:seed && set ELECTRON_RUN_AS_NODE=&& electron-builder --win",
    "prepare:seed": "node scripts/prepare-seed.cjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.cutoutstudio.app",
    "productName": "Cutout Studio",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist/v${version}"
    },
    "files": [
      "electron/**",
      "editor-ui/dist/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist/image-pipeline-api",
        "to": "backend/image-pipeline-api"
      },
      {
        "from": "realesrgan-ncnn-vulkan",
        "to": "realesrgan-ncnn-vulkan",
        "filter": [
          "**/*",
          "!models/realesr-animevideov3-x3.*",
          "!models/realesr-animevideov3-x4.*",
          "!models/realesrgan-x4plus-anime.*",
          "!vcomp140d.dll"
        ]
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "build-seed/templates_custom.json",
        "to": "templates_custom.json"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
