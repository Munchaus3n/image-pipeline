{
  "name": "image-pipeline-electron-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Electron packaging shell for Image Pipeline Pro.",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:electron:dev:ui\" \"npm:electron:dev:app\"",
    "electron:dev:ui": "npm --prefix editor-ui run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "electron:dev:app": "set ELECTRON_RUN_AS_NODE=&& wait-on tcp:127.0.0.1:5173 && electron .",
    "electron:build-ui": "npm --prefix editor-ui run build",
    "electron:dist": "npm run electron:build-ui && set ELECTRON_RUN_AS_NODE=&& electron-builder",
    "electron:dist:win": "npm run electron:build-ui && set ELECTRON_RUN_AS_NODE=&& electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.imagepipeline.pro",
    "productName": "Image Pipeline Pro",
    "asar": false,
    "files": [
      "electron/**",
      "editor-ui/dist/**",
      "api.py",
      "pipeline.py",
      "config.ini",
      "templates/**",
      "templates_custom.json",
      "realesrgan-ncnn-vulkan/**",
      "!output/**",
      "!.cache/**",
      "!session.json",
      "!settings.json",
      "!input/**",
      "!downloaded/**",
      "!test-images/**",
      "!venv311/**",
      "!__pycache__/**",
      "!editor-ui/node_modules/**",
      "!dist/**",
      "!release/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
